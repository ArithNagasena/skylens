# ─── Live Google reviews (homepage reviews section) ───────────────────────
# Both must be set for real reviews to appear. If either is missing the site
# falls back to src/content/reviews.ts, then to a Facebook link-out — it never
# breaks. Full setup steps are in src/lib/google-reviews.ts.
#
#   1. Create + verify a Google Business Profile   https://business.google.com
#   2. Find its Place ID                            https://developers.google.com/maps/documentation/places/web-service/place-id
#   3. Enable "Places API (New)" in Google Cloud, create a key, attach billing
#
# Copy this file to `.env.local` and fill both in. Never commit `.env.local`.

GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# ─── Supabase (admin panel + site content) ────────────────────────────────
# Both are required for /admin to work at all. Without them the public site
# still renders — every section falls back to the content in src/content —
# and the admin panel says what is missing instead of showing dead forms.
#
# Find them in your Supabase project under Settings → API. The anon key is
# safe in the browser: it is the key the public site reads content with, and
# row-level security is what decides who may write. Never put the service_role
# key in this file — it bypasses every policy.
#
# Full setup, including the two SQL files and granting yourself admin access,
# is in supabase/README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
